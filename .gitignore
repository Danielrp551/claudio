# Binaries. The patterns are anchored to the repository root on purpose: an
# unanchored "claudio" also matches the cmd/claudio directory, which would
# quietly leave the main package out of the repository.
/bin/
/dist/
/claudio
/claudio.exe

# Go
/vendor/
*.test
*.out
coverage.txt

# Editors
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Local state produced while running the tool
*.local.json
